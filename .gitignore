node_modules
dist
dist-ssr
*.local
.DS_Store
coverage
.vite
*.tsbuildinfo

# Compiled output never belongs beside the source it came from: Vite resolves
# `./x` to `x.js` before `x.ts`, and picks up `vite.config.js` before
# `vite.config.ts`, so a stray artefact silently replaces its own source.
/src/**/*.js
/src/**/*.d.ts
!/src/sw/*.js
/*.config.js
/vitest.workspace.js
.artifacts/

# Bodies built by tools/body/build.py: rebuilt from the data, byte for byte.
/tools/body/out/
__pycache__/
